# Environment
NODE_ENV=your_node_env

# Frontend Configuration
# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# App Configuration  
NEXT_PUBLIC_APP_NAME=EV Rental System
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true


# Server Configuration - PORT BACKEND
PORT=5000

# Database Configuration
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_SYNC=false
DB_ENCRYPT=false
DB_TRUSTSERVERCERTIFICATE=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# --- CLOUDINARY CONFIG ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- VNPAY CONFIGURATION ---
# Required: VNPay Terminal ID (TMN Code) - Get from VNPay merchant dashboard
VNPAY_TMN_CODE=your_tmn_code

# Required: VNPay Secure Secret - Get from VNPay merchant dashboard
VNPAY_SECURE_SECRET=your_secure_secret

# Optional: VNPay Gateway URL (default: sandbox)
# For production: https://vnpayment.vn
# For sandbox: https://sandbox.vnpayment.vn
VNPAY_HOST=https://sandbox.vnpayment.vn

# Optional: Test mode (default: false)
# Set to 'true' for testing, 'false' for production
VNPAY_TEST_MODE=true

# Optional: Hash algorithm (default: SHA512)
# Options: SHA512, SHA256, MD5
VNPAY_HASH_ALGORITHM=SHA512

# Optional: Enable logging (default: false)
# Set to 'true' to enable VNPay logging
VNPAY_ENABLE_LOG=true

# Optional: Return URL after payment (default: http://localhost:3000/payment/callback)
# This is where VNPay will redirect after payment completion
VNPAY_RETURN_URL=http://localhost:3000/payment/callback

# --- BACKEND PORT (Optional) ---
# Backend API port (default: 5000)
BACKEND_PORT=5000
